      <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor UTG-1" enabled="false">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import groovy.json.JsonSlurper

try {
    // Получаем конфиг для UTG-1
    def utgConfig = new JsonSlurper().parseText(props.get(&apos;utg1Config&apos;))
    def utg = ctx.getThreadGroup()

    // Установка переменной для Constant Throughput Timer
    if (utgConfig.targetThroughput != null) {
        vars.put(&apos;UTG1_TARGET_THROUGHPUT&apos;, utgConfig.targetThroughput.toString())
        log.info(&quot;Установлен targetThroughput для UTG-1: ${utgConfig.targetThroughput} samples/min&quot;)
    } else {
        log.warn(&quot;targetThroughput не указан для UTG-1, используется значение по умолчанию&quot;)
    }

    // Настройка ступеней нагрузки
    utg.getThreadGroupSchedule().clear()
    
    utgConfig.stages.eachWithIndex { stage, index -&gt;
        utg.addNewSchedule()
        utg.setStartThreads(stage.threads as int)
        utg.setInitialDelay(stage.delay as int)
        utg.setRampUp(stage.rampup as int)
        utg.setHoldDuration(stage.duration as int)
        utg.setShutdownTime(stage.shutdown as int)
        
        log.info(&quot;UTG-1: Ступень ${index + 1} - ${stage.threads} потоков, delay: ${stage.delay} сек&quot;)
    }
} catch (Exception e) {
    log.error(&quot;Ошибка в PreProcessor UTG-1: &quot; + e.getMessage(), e)
    throw e
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Flow Control Action">
          <intProp name="ActionProcessor.action">1</intProp>
          <intProp name="ActionProcessor.target">0</intProp>
          <stringProp name="ActionProcessor.duration">0</stringProp>
        </TestAction>
        <hashTree>
          <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="Constant Throughput Timer">
            <stringProp name="throughput">${__P(TG1_THROUGHPUT,9.6)}</stringProp>
            <intProp name="calcMode">0</intProp>
            <stringProp name="TestPlan.comments"> ${__P(UTG1_TARGET_THROUGHPUT)}</stringProp>
          </ConstantThroughputTimer>
          <hashTree/>
        </hashTree>
